# Copy to .env.local. Never commit real credentials.
SITE_URL=http://localhost:3000
DATABASE_URL=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
ADMIN_EMAIL=
# Generate a bcrypt hash; see README.
ADMIN_PASSWORD_HASH=
# Optional inquiry notifications via Resend. Stored inquiries remain available if email fails.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Optional Mux configuration, integration still pending.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
